    {
      "id": 17,
      "title": "Almacenamiento (PVC) por cliente",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
