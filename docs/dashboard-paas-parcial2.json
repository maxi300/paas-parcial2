          },
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"portal-clientes|pos-ventas|tecno-morazan\", container!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "range": true,
