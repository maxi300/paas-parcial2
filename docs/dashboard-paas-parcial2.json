      }
    },
    {
      "id": 18,
      "title": "Latencia p95 por cliente (Ingress)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, exported_namespace) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=~\"portal-clientes|pos-ventas|tecno-morazan\"}[5m])))",
          "legendFormat": "{{exported_namespace}}",
