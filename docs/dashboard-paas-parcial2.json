      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (namespace) (kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=~\"portal-clientes|pos-ventas|tecno-morazan\"})",
          "legendFormat": "{{namespace}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
